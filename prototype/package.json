{
  "name": "atelier-prototype",
  "version": "0.1.0-m2",
  "private": true,
  "description": "Atelier prototype web app: canonical artifact + coordination dashboard. Per ADR-001 + prototype/README.md.",
  "scripts": {
    "codegen": "tsx ../scripts/build/generate-bundled-config.ts",
    "predev": "npm run codegen",
    "dev": "next dev -p 3030",
    "prebuild": "npm run codegen",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:a11y": "playwright test --config playwright.a11y.config.ts",
    "precf:build": "npm run codegen",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "cf:upload": "opennextjs-cloudflare upload"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@sentry/nextjs": "^10.51.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.105.1",
    "@vercel/otel": "^2.1.2",
    "gray-matter": "^4.0.3",
    "jose": "^5.9.6",
    "lucide-react": "^1.14.0",
    "next": "^15.1.0",
    "pg": "^8.20.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@opennextjs/cloudflare": "^1.0.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "wrangler": "^4.0.0"
  }
}
